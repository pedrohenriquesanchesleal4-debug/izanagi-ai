.npmrc
node_modules
*.log
.DS_Store
tmp/
dist/
site/node_modules/
site/.next/
# .agents/: memória persistente e artefatos locais NUNCA são versionados; o resto
# (ex.: .agents/agents/*.yaml derivados pelo agent-migrator, ADR-005) é rastreável.
# Gitignore não reinclui filhos de diretório inteiramente excluído ("parent directory
# excluded"), então o antigo `.agents/` vira negativa fina por artefato local:
.agents/memoria/
.agents/auditoria/
.Izanagi/
.izanagi/
site/
opencode.json

# Artefato gerado pelo comando 'izanagi run'
izanagi-prompt.md
my-project/

# Gerado por 'npm run build' (generate-manifest.js) — sempre fresco no build/prepublishOnly,
# nunca deve ser commitado (senão cada build local suja o working tree com diffs).
.manifest

# Agentes gerados por 'izanagi agent create' ficam locais por padrão (draft, não promovido).
# Só entram no repo com 'git add -f' deliberado após passar por validação/scan/benchmark real
# (evita repetir o incidente de placeholders de teste comitados por engano).
agents/generated/*

# --- Refatoração poliglota: artefatos de build/runtime por linguagem ---
# Rust (cargo build/test/check em crates/)
target/
# Python (venv do python-engine e caches de bytecode)
.python-engine-venv/
python-engine/.venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
# Cargo.lock da workspace raiz É commitado (crates produzem binários);
# não adicionar ao ignore.
